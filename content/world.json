  "events": [
    {
      "id": "huangjin",
      "name": "黄巾起事",
      "fromYear": 184,
      "toYear": 184,
      "era": "中平元年",
      "placeIds": [
        "luoyang",
        "ye",
        "zhuozhou"
      ],
      "chapterIds": [
        "001"
      ],
      "summary": "太平道聚众起事，州郡募兵，群雄由此登场。",
      "phases": {
        "cause": "宦官外戚相争、连年灾疫，民心思变。",
        "process": "张角兄弟以太平道聚众，八州并起；朝廷募义兵镇压。",
        "result": "张角病死，主力溃散，但地方募兵与豪强武装从此坐大。"
      },
      "viewpoints": [
        {
          "personId": "liubei",
          "text": "我等在涿郡募兵，所恃者唯人和与一纸汉室名分。"
        },
        {
          "personId": "zhangjiao",
          "text": "苍天已死，黄天当立；只是这一年之后，天下再无太平。"
        }
      ]
    },
    {
      "id": "taodong",
      "name": "关东联军讨董",
      "fromYear": 190,
      "toYear": 190,
      "era": "初平元年",
      "placeIds": [
        "luoyang",
        "changan"
      ],
      "chapterIds": [
        "005"
      ],
      "summary": "诸侯会盟讨董，迁都长安，联盟随即瓦解。",
      "phases": {
        "cause": "董卓入洛阳废立、专擅朝政。",
        "process": "曹操发矫诏，关东诸郡会盟；董卓焚洛阳，迁都长安。",
        "result": "盟军各怀异心，各自引兵归，转为群雄割据。"
      },
      "viewpoints": [
        {
          "personId": "caocao",
          "text": "诸君迟疑不进，我只好独自西向；此后不再指望盟约。"
        },
        {
          "personId": "yuanshao",
          "text": "盟主之名好听，可谁先出兵，谁先耗掉自己的兵。"
        }
      ]
    },
    {
      "id": "guandu",
      "name": "官渡之战",
      "fromYear": 200,
      "toYear": 200,
      "era": "建安五年",
      "placeIds": [
        "guandu",
        "baima",
        "ye",
        "xuchang"
      ],
      "chapterIds": [
        "030"
      ],
      "summary": "曹操以少击众，烧毁乌巢粮草，河北格局逆转。",
      "phases": {
        "cause": "袁绍据四州南下，曹操迎天子都许，双方必有一战。",
        "process": "相持官渡数月，曹操夜袭乌巢，焚袁军粮草。",
        "result": "袁绍大败，两年后病死；曹操逐步平定河北。"
      },
      "viewpoints": [
        {
          "personId": "caocao",
          "text": "粮草一断，兵多也无用；我所赌的，是他不敢分兵救乌巢。"
        },
        {
          "personId": "yuanshao",
          "text": "田丰劝我缓攻，我不听；后来才知慢一年，赢面会大得多。"
        }
      ]
    },
    {
      "id": "sangu",
      "name": "三顾茅庐 · 隆中对",
      "fromYear": 207,
      "toYear": 207,
      "era": "建安十二年",
      "placeIds": [
        "xinye",
        "longzhong"
      ],
      "chapterIds": [
        "037",
        "038"
      ],
      "summary": "刘备三访隆中，得到一份跨有荆益的天下规划。",
      "phases": {
        "cause": "刘备寄居荆州，屡失根据地，急需一条明确路线。",
        "process": "司马徽、徐庶荐诸葛亮，刘备凡三往乃见。",
        "result": "隆中对定下先荆后益、两路北伐的方略。"
      },
      "viewpoints": [
        {
          "personId": "liubei",
          "text": "我缺的不是勇气，是一张能走十年的地图。"
        },
        {
          "personId": "zhugeliang",
          "text": "隆中不过二十七岁的一席话；前提是要有人肯等三次。"
        }
      ]
    },
    {
      "id": "chibi",
      "name": "赤壁之战",
      "fromYear": 208,
      "toYear": 208,
      "era": "建安十三年",
      "placeIds": [
        "jingzhou",
        "xiakou",
        "chibi",
        "wulin",
        "huarong",
        "jiangling"
      ],
      "chapterIds": [
        "043",
        "044",
        "046",
        "049",
        "050"
      ],
      "summary": "孙刘联军于长江中游以火攻破曹，三分之势由此成形。",
      "phases": {
        "cause": "曹操南下得荆州，顺江东进；孙权在战和之间，刘备退守夏口。",
        "process": "诸葛亮使吴、周瑜统兵；黄盖火船乘东南风突入曹军水寨，战船连锁难以散开。",
        "result": "曹军北撤，孙权稳据江东，刘备趁势取荆南，天下三分的雏形出现。"
      },
      "viewpoints": [
        {
          "personId": "caocao",
          "text": "北方之兵不习水战，疫病又起；把船锁在一起本是稳军心，却成了最大的破绽。"
        },
        {
          "personId": "zhouyu",
          "text": "我算的不是东风，是曹军的水战短板、粮道与疫病；火只是最后一步。"
        },
        {
          "personId": "liubei",
          "text": "此战之后我才有立足之地；此前的二十年，一直在借别人的屋檐。"
        },
        {
          "personId": "zhugeliang",
          "text": "我此行只做了一件事：让江东相信，抵抗比归附更划算。"
        }
      ],
      "highlight": true
    },
    {
      "id": "yizhou",
      "name": "刘备定益州",
      "fromYear": 212,
      "toYear": 214,
      "era": "建安十九年",
      "placeIds": [
        "chengdu",
        "hanzhong",
        "jingzhou"
      ],
      "chapterIds": [
        "065"
      ],
      "summary": "刘备入蜀收定益州，隆中对的「跨有荆益」落地。",
      "phases": {
        "cause": "刘璋邀刘备入蜀御张鲁，双方终至兵戎相见。",
        "process": "诸葛亮、张飞溯江入蜀，刘备围成都，刘璋出降。",
        "result": "刘备自领益州牧，同时守荆州与益州的长线也就此成形。"
      },
      "viewpoints": [
        {
          "personId": "liubei",
          "text": "有了益州，才有资格谈天下；可荆州与益州之间，隔着太远的路。"
        },
        {
          "personId": "zhugeliang",
          "text": "两路出兵的前提是两路都稳，这条线后来成了最脆弱的一环。"
        }
      ]
    },
    {
      "id": "tuogu",
      "name": "白帝城托孤",
      "fromYear": 223,
      "toYear": 223,
      "era": "章武三年",
      "placeIds": [
        "chengdu",
        "jingzhou"
      ],
      "chapterIds": [
        "085"
      ],
      "summary": "夷陵败后刘备托孤，诸葛亮独撑蜀汉全局。",
      "phases": {
        "cause": "夷陵大败，刘备退驻永安，病势日重。",
        "process": "召诸葛亮托孤，嘱以嗣子与国事。",
        "result": "刘禅即位，诸葛亮开府治事，重新修复与吴的联盟。"
      },
      "viewpoints": [
        {
          "personId": "liubei",
          "text": "我把话说得那样重，是因为除了他，再无人能接住这局面。"
        },
        {
          "personId": "zhugeliang",
          "text": "草庐里我讲十年规划，如今要一个人把往后十一年都扛下来。"
        }
      ]
    },
    {
      "id": "beifa",
      "name": "诸葛亮北伐",
      "fromYear": 228,
      "toYear": 234,
      "era": "建兴六年至十二年",
      "placeIds": [
        "hanzhong",
        "jieting",
        "wuzhangyuan"
      ],
      "chapterIds": [
        "095",
        "104"
      ],
      "summary": "五次北出秦岭，街亭失守，最终卒于五丈原。",
      "phases": {
        "cause": "蜀汉以一州之力抗中原，若不北出，强弱只会更悬。",
        "process": "一出祁山，马谡失街亭；此后数出，粮运不继，与司马懿对峙渭南。",
        "result": "建兴十二年卒于五丈原，蜀汉转入守势。"
      },
      "viewpoints": [
        {
          "personId": "zhugeliang",
          "text": "粮道比谋略更难；每一次退兵，都不是因为算错，而是因为运不到。"
        },
        {
          "personId": "simayi",
          "text": "我只需守住不出，等他的粮尽。"
        }
      ]
    },
    {
      "id": "guijin",
      "name": "三国归晋",
      "fromYear": 263,
      "toYear": 280,
      "era": "景耀六年至太康元年",
      "placeIds": [
        "chengdu",
        "luoyang",
        "jianye"
      ],
      "chapterIds": [
        "119",
        "120"
      ],
      "summary": "蜀亡、魏禅、吴降，近百年的分裂收束。",
      "phases": {
        "cause": "魏国国力远胜，蜀吴相继内耗。",
        "process": "邓艾入成都，司马炎代魏建晋，王濬楼船顺江东下。",
        "result": "孙皓出降，三分归一。"
      },
      "viewpoints": [
        {
          "personId": "simayan",
          "text": "天下大势，合久必分，分久必合；我不过站在最后一段上。"
        },
        {
          "personId": "sunhao",
          "text": "江险仍在，只是守江的人已经不齐了。"
        }
      ]
    }
  ],
